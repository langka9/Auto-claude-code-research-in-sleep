# ARIS Configuration — copy this file to .env and fill in your values
# Place .env in the same directory as install_aris_flat.ps1, or in your idea project root.

# llm-wiki: your Obsidian knowledge base path
LLM_WIKI_PATH=D:\BaiduSyncdisk\obsidian_projects\llm-wiki

# ARIS repo: path to Auto-claude-code-research-in-sleep repository
# Leave empty to auto-detect (parent of script dir, or common locations)
ARIS_REPO=D:\BaiduSyncdisk\code\MyDemo\Auto-claude-code-research-in-sleep

# Semantic Scholar API Key (required for semantic-scholar skill)
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-api-key-here
